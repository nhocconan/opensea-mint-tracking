[Unit]
Description=CARV verifier node (earning workload - must always be running)
Documentation=file:///home/carv/docker-compose.yml
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/carv
TimeoutStartSec=300
ExecStart=/usr/bin/docker compose -p carv -f /home/carv/docker-compose.yml up -d --no-build
# Prove the verifier is actually advancing the chain cursor, not merely "Up".
ExecStartPost=/home/web/opensea-tools/infra/systemd/carvnode-watchdog.sh
# No ExecStop: this workload earns money, so a systemd daemon-reload or a unit
# restart must never be able to take it offline. Stop it deliberately with
# `docker compose -p carv -f /home/carv/docker-compose.yml stop`.

[Install]
WantedBy=multi-user.target
