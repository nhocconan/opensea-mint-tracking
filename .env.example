# HoodMint Radar — environment template
# Copy to `.env`, then run `make bootstrap` (generates secrets; never overwrites).
# Restart required? — web/worker must restart for any var marked [restart].

# ── Core runtime ────────────────────────────────────────────────────────────
# development | production. production enables HSTS, secure cookies, strict CSP.
APP_ENV=production
# Public origin of the web app; used for auth redirects and trusted origins. [restart]
APP_URL=http://localhost:3960
# Host-published web port (local sequence starts at 3960). [restart]
PORT=3960
# Worker liveness bind (host 3963 when run via scripts/start-dev.sh). [restart]
WORKER_HEALTH_PORT=3963
# Log level: trace|debug|info|warn|error. [restart]
LOG_LEVEL=info

# ── Secrets (generated by `make bootstrap`; base64, 32 bytes) ───────────────
# AES-256-GCM key for encrypting provider credentials at rest. [restart]
APP_ENCRYPTION_KEY=
# Managed minting keys: X25519 envelope so ONLY the worker can decrypt them
# (`make wallet-keys`). Public half → web + worker; private half → worker only.
# Any of these root secrets may be given as <NAME>_FILE=/path instead. [restart]
WALLET_KEY_PUBLIC_KEY=
WALLET_KEY_PRIVATE_KEY=
# Secret for Better Auth session signing. [restart]
BETTER_AUTH_SECRET=

# ── PostgreSQL 18 ───────────────────────────────────────────────────────────
# Host URL for scripts/start-dev.sh / make migrate. Compose overrides this to
# postgres://hoodmint:hoodmint@postgres:5432/hoodmint inside containers. [restart]
DATABASE_URL=postgres://hoodmint:hoodmint@127.0.0.1:3961/hoodmint

# ── Valkey (Redis protocol) — queues and short-lived cache only ─────────────
# Host URL; compose overrides to redis://valkey:6379/0 inside containers.
VALKEY_URL=redis://127.0.0.1:3962/0

# ── Robinhood Chain ─────────────────────────────────────────────────────────
ROBINHOOD_CHAIN_ID=4663
# Optional HTTP RPC endpoint for the on-chain radar. Read-only, no keys needed.
# Example managed endpoint: https://rpc.robinscan.io
RPC_URL=
# Optional WebSocket RPC for low-latency hints; HTTP always reconciles. [restart]
RPC_WS_URL=
# Block range for the first eth_getLogs sweep; adapts automatically. [restart]
CHAIN_SYNC_INITIAL_RANGE=5000
# Seconds between chain-sync cycles. [restart]
CHAIN_SYNC_INTERVAL_SECONDS=15

# ── OpenSea provider ────────────────────────────────────────────────────────
# Leave empty to let the worker create and rotate free 7-day instant keys.
# Prefer entering a Developer Portal key in Admin → OpenSea instead of this var.
OPENSEA_API_KEY=
OPENSEA_API_BASE=https://api.opensea.io
# Fallback identifier when /api/v2/chains has not listed chain 4663 yet.
OPENSEA_CHAIN_FALLBACK=robinhood
# Discovery cycle seconds (PRD quota table: 300 → 36 reads/hour). [restart]
DISCOVERY_INTERVAL_SECONDS=300
# Max pages per drops list call. [restart]
OPENSEA_MAX_PAGES=5
# Percentage of hourly quota held in reserve; provider stops before exhaustion.
OPENSEA_RATE_RESERVE_PERCENT=10
# Assumed instant-tier limit (reads/hour) for quota math.
OPENSEA_HOURLY_LIMIT=600

# ── Eligibility engine ──────────────────────────────────────────────────────
# Donated in Admin → OpenSea as an encrypted PAT scoped to read:eligibility.
# This var exists only for headless setups; the UI path is preferred.
OPENSEA_WALLET_PAT=

# ── Alerts ──────────────────────────────────────────────────────────────────
# Default = empty; configure channels in Admin → Alerts (encrypted at rest).
# Comma-separated minutes before an eligible stage starts that trigger alerts.
ALERT_STAGE_WINDOWS_MINUTES=60,15,5

# ── Demo / seed ─────────────────────────────────────────────────────────────
# Seeds deterministic demo data and shows the persistent DEMO DATA banner.
DEMO_MODE=false
# Optional dev-only prefill for the Admin → Wallets form; ignored unless
# APP_ENV=development. Tracked wallets are added in Admin → Wallets — the app
# ships with no wallet baked in, and none is required for it to run.
DEFAULT_WALLET_ADDRESS=

# ── Execution (ADR 0003–0008; docs/execution-architecture.md) ───────────────
# Hard default false — shadow/dry-run only. Even when true, only the
# browser_wallet signer scheme (the owner signs client-side, zero server
# custody) can act on it; Phase 2 delegated custody is not implemented yet.
LIVE_EXECUTION_ENABLED=false
MINT_WATCH_INTERVAL_SECONDS=30

# ── Sentiment signals (ADR 0007, revised 2026-08-28) ────────────────────────
# Hard default false. The scan reads X through xAI's Grok (server-side
# x_search tool), authorized by the operator's X Premium+/SuperGrok
# subscription via device-code OAuth — connect it at Admin → Signals, no env
# var needed and no separate X API billing. Nothing runs without this flag
# AND a resolvable credential.
X_SIGNALS_ENABLED=false
# Model id — names rev (grok-4.5/4.6 exist), so it is configurable.
XAI_MODEL=grok-4
# Optional console.x.ai API key fallback for a headless bootstrap; the
# credentials stored via Admin → Signals take priority over this.
XAI_API_KEY=
# Legacy direct X API bearer. No longer used by the scan (X retired its free
# tier Feb 2026); kept so existing deployments still parse.
X_API_BEARER_TOKEN=

# ── Web Push alert channel (shipped 2026-08-22) ─────────────────────────────
# Opt-in: the "Browser push" section on /admin/alerts stays hidden until all
# three are set. Generate once with `make vapid-keys` and keep forever —
# rotating invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Optional observability exporter (no-op when unset) ──────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
