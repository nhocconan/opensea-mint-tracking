# Production env — copy to .env.prod on the prod host and fill in real
# values. .env.prod is gitignored so it is never overwritten by a pull.
# Referenced by compose.prod.yaml (Traefik + the app stack).

# ── Traefik / ingress ───────────────────────────────────────────────────
APP_DOMAIN=radar.example.com
ACME_EMAIL=you@example.com

# ── Datastore secret (used by both postgres and the app DSN) ─────────────
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=production
# Must match https://${APP_DOMAIN} — Better Auth / cookies depend on it.
APP_URL=https://radar.example.com
LOG_LEVEL=info

# 32 bytes base64 — `openssl rand -base64 32`. Encrypts every credential at
# rest INCLUDING the delegated-custody session key (ADR 0004). Rotating this
# invalidates all stored credentials — treat as a root secret.
APP_ENCRYPTION_KEY=
# Managed minting keys are sealed to this X25519 keypair (`make wallet-keys`):
# the web container gets ONLY the public key, the worker gets the private
# key — so a compromised web process cannot decrypt a minting key. Set the
# private half via WALLET_KEY_PRIVATE_KEY_FILE (docker secret / tmpfs) on
# the worker service rather than here. See compose.prod.yaml.sample.
WALLET_KEY_PUBLIC_KEY=
WALLET_KEY_PRIVATE_KEY=
# `openssl rand -base64 48`
BETTER_AUTH_SECRET=

# ── Chain ─────────────────────────────────────────────────────────────────
ROBINHOOD_CHAIN_ID=4663
# Prefer an RPC endpoint physically close to the sequencer — see
# docs/deployment.md. This is the single biggest FCFS-competitiveness lever.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_WS_URL=

# ── OpenSea ───────────────────────────────────────────────────────────────
OPENSEA_API_KEY=

# ── Execution (ADR 0004/0005/0008/0009) ──────────────────────────────────
# HARD DEFAULT OFF. Flip to true only once a signer is onboarded/activated
# and you have accepted the ToS risk. Shadow mode until then.
LIVE_EXECUTION_ENABLED=false
# Coarse fallback claim cadence; the precision hot-loop below is what
# actually wins races.
MINT_WATCH_INTERVAL_SECONDS=30
# Precision fire tuning — measure round-trip to your RPC and set LEAD_MS to
# just above it. See packages/core/fire-schedule.ts and docs/deployment.md.
MINT_HOT_LOOP_INTERVAL_MS=200
MINT_FIRE_HOT_WINDOW_MS=2000
MINT_FIRE_LEAD_MS=150
MINT_FIRE_CONTINUE_MS=4000

# ── Optional signals / push ───────────────────────────────────────────────
X_SIGNALS_ENABLED=false
X_API_BEARER_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
