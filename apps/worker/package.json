    "@hoodmint/notifications": "workspace:*",
    "@hoodmint/observability": "workspace:*",
    "@hoodmint/providers": "workspace:*",
    "@hoodmint/queues": "workspace:*",
    "@hoodmint/secrets": "workspace:*",
    "@hoodmint/signals": "workspace:*",
    "@hoodmint/signing": "workspace:*",
    "bullmq": "6.1.2",
    "ioredis": "6.0.0",
    "tsx": "4.23.12",
    "viem": "2.55.16",
    "zod": "4.4.3",
    "drizzle-orm": "0.45.2"
  },
