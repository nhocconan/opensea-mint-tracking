{
  "name": "hoodmint-radar",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted NFT drop discovery and allowlist eligibility radar for Robinhood Chain",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "dev": "pnpm -r --parallel run dev",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome check --linter-enabled=true --formatter-enabled=false . && bash scripts/audit/read-path-boundaries.sh",
    "audit:architecture": "bash scripts/audit/read-path-boundaries.sh",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:integration": "bash scripts/integration-tests.sh",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "migrate": "pnpm --filter @hoodmint/db exec tsx src/migrate.ts",
    "migration": "pnpm --filter @hoodmint/db run migration:generate --",
    "seed": "pnpm --filter @hoodmint/worker exec tsx ../../scripts/seed.ts",
    "bootstrap-token": "pnpm --filter @hoodmint/worker exec tsx ../../scripts/bootstrap-token.ts",
    "vapid-keys": "pnpm --filter @hoodmint/notifications exec tsx ../../scripts/vapid-keys.ts",
    "wallet-keys": "pnpm --filter @hoodmint/worker exec tsx ../../scripts/wallet-keys.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "esbuild": "0.25.12",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
