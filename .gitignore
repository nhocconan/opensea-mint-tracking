.env
.env.local

# Production deployment files — copied from *.sample on the prod host and
# filled with real secrets/domain. Never track these; a pull/agent edit
# must never overwrite the operator's live prod config. Only the committed
# *.sample files are the source of truth.
.env.prod
compose.prod.yaml
docker-compose.prod.yml
traefik/acme.json
secrets/
traefik/*.local.*
letsencrypt/
.state/
.dev/
__pycache__/
*.pyc
node_modules/
dist/
.next/
coverage/
*.tsbuildinfo
.playwright/
test-results/
.DS_Store
*.log
.gstack/
.env.bak*
.env.*.bak

# throwaway in-network probe scripts
apps/worker/__*.mts

# backups contain secrets (encrypted) — never in git
backups/
restored-config/

# Server-local ingress stack (Traefik) — real ACME account data + operator
# email live here; created on the host, never tracked.
infra/ingress/.env

# Host-specific hardening script — contains admin source IPs.
infra/host/
infra/ingress/
