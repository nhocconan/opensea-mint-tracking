# Required. The wallet to check eligibility for; nothing is baked into the code.
WALLET_ADDRESS=
OPENSEA_CHAIN=robinhood
POLL_INTERVAL_SECONDS=300

# Optional. If empty, the service creates and rotates a free 7-day instant key.
OPENSEA_API_KEY=

# Required for pre-mint, per-wallet whitelist checks. Prefer a scoped PAT.
OPENSEA_WALLET_PAT=
# Or provide a short-lived wallet JWT instead.
OPENSEA_WALLET_JWT=

# Optional alert destinations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
STATE_DIR=.state
